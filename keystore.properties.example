# Copy to keystore.properties (which is gitignored) and fill in.
#
# Create the key once:
#
#   keytool -genkey -v \
#     -keystore bitcoin-core-node-release.jks \
#     -alias cyberspace \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype PKCS12
#
# 4096-bit RSA and a ~27-year validity are deliberate. Play App Signing will
# hold the deployment key, but this upload key is what proves an update came
# from you, and re-keying it is a support ticket you do not want to file.

storeFile=../bitcoin-core-node-release.jks
storePassword=CHANGE_ME
keyAlias=bitcoincorenode
keyPassword=CHANGE_ME
