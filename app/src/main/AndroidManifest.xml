<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talking to peers (embedded) or to your own node (remote). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The node runs as a foreground service so Android does not kill it
         mid-validation. dataSync is the correct type: we are synchronising a
         dataset the user explicitly asked for. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Partial wakelock only, and only while syncing with the screen off, and
         only if the user turns it on in Settings. Off by default. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Scanning addresses, PSBTs and BIP21 URIs. Optional: the app is fully
         usable by pasting instead, and declares the feature non-required so it
         installs on devices without a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Deliberately NOT requested:
         - READ/WRITE_EXTERNAL_STORAGE : PSBT and wallet import/export use the
           Storage Access Framework, which needs no permission and gives the
           user per-file control.
         - RECEIVE_BOOT_COMPLETED      : a node that silently starts itself on
           boot and eats the battery is hostile. The user starts it.
         - ACCESS_FINE_LOCATION, READ_CONTACTS, READ_PHONE_STATE : no.
         - Any advertising or analytics identifier: no. -->

    <application
        android:name=".BitcoinCoreNodeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BitcoinCoreNode"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="35">

        <!-- Injected from app/ads.properties, which is not in this
             repository. Empty in a clean checkout, where no ad SDK is
             compiled in to read it. See the note in app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Cleartext is allowed to 127.0.0.1 only (the embedded node's own RPC
             port) and nowhere else. See res/xml/network_security_config.xml. -->
        <meta-data
            android:name="android.security.NETWORK_SECURITY_CONFIG"
            android:resource="@xml/network_security_config" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.BitcoinCoreNode.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- BIP21 payment URIs: bitcoin:bc1q...?amount=0.01 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bitcoin" />
            </intent-filter>

            <!-- Opening a .psbt file from Files, email or a messenger. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/psbt" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          Same process as the UI, deliberately, reversing an earlier decision.

          The node supervisor is a Hilt @Singleton, and Hilt singletons are
          PER PROCESS. With android:process=":node" the service got its own
          NodeSupervisor instance and the UI observed a different one that had
          never started anything: the service would run a node the screens could
          not see. Process isolation is only worth having if the two halves can
          still talk, and that would need AIDL or a Messenger for no real gain —
          bitcoind is already a separate OS process, so a node crash cannot take
          the app down either way.

          stopWithTask="false" is kept so the service outlives the task being
          swiped away for long enough to shut the node down CLEANLY in
          onTaskRemoved(). Setting it true would let Android kill us mid-flush,
          which is how a chainstate gets corrupted.
        -->
        <service
            android:name=".service.NodeService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- TorService is not implemented yet. Tor currently routes through
             Orbot's SOCKS proxy, which needs no service of ours. The declaration
             was removed rather than left pointing at a class that does not
             exist. -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager's default initializer is removed and replaced by the
             Hilt-aware one in BitcoinCoreNodeApp. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
